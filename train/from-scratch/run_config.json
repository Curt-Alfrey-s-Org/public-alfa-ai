{
  "schema_version": 1,
  "name": ".45b",
  "step": "corpus",
  "precision": "bf16",
  "fim": false,
  "seq_len": 2048,
  "tokenizer_id": "Qwen/Qwen2.5-Coder-7B-Instruct",
  "tokenizer_eos_token": "change-me",
  "tokenizer_fallback_id": "bigcode/starcoder2-3b",
  "unk_rate_max": 0.01,
  "tokenizer_fit_rule": "Use tokenizer_id (the 7B QLoRA tokenizer, a code BPE). If the packed text unk rate is above unk_rate_max, stop and rerun with tokenizer_fallback_id (StarCoder2 byte-level BPE). Do not download a new tokenizer on a trainer host; read the hub HF cache.",
  "sequences_per_shard": 256,
  "model": {
    "n_layer": 24,
    "n_embd": 1024,
    "n_head": 16,
    "seq_len": 2048,
    "mlp_mult": 4,
    "rope_theta": 10000.0,
    "init_std": 0.02
  },
  "adamw": {
    "lr": 0.0003,
    "betas": [0.9, 0.95],
    "weight_decay": 0.1,
    "fused": true
  },
  "muon": {
    "lr": 0.02,
    "momentum": 0.95,
    "weight_decay": 0.1,
    "adjust_lr_fn": "original"
  },
  "replay": {
    "upsample": 2,
    "rewarm": false,
    "retention_patience": 3
  },
  "desktop_reserve_gb": 3,
  "desktop_hosts": ["orchestrator", "gaming-c", "gaming-b"],
  "headless_hosts": ["inference"],
  "checkpoints": {
    "canonical": "/mnt/HDDs/Alfa-AI/training/alfa-train/checkpoints/from-scratch",
    "nfs": "/mnt/cluster/training/alfa-train/checkpoints/from-scratch",
    "smb": "\\\\hub\\training\\alfa-train\\checkpoints\\from-scratch"
  },
  "hub": {
    "canonical": "/mnt/HDDs/Alfa-AI/training/alfa-train/datasets/from-scratch",
    "nfs": "/mnt/cluster/training/alfa-train/datasets/from-scratch",
    "smb": "\\\\hub\\training\\alfa-train\\datasets\\from-scratch"
  },
  "do_not_overwrite": [
    "alfa-corpus-train.jsonl",
    "alfa-corpus-val.jsonl",
    "alfa-corpus-multirepo-train.jsonl",
    "alfa-corpus-multirepo-val.jsonl"
  ],
  "constraints": {
    "precision": "bf16",
    "no_fp8": true,
    "attention": "sdpa",
    "no_flashattention3": true,
    "no_zero3_for_410m": true,
    "pi": false,
    "petals": false,
    "replaces_7b_qlora": false
  }
}
