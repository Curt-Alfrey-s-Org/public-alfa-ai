# syntax=docker/dockerfile:1
# alfa-ai-frontend — Vite SPA built with Node and served by nginx-alpine.
#
# This decouples the frontend from the Python API image. The API no longer has
# to rebuild (and therefore reinstall pip deps on cache misses) when a React
# file changes; the frontend container rebuilds alone in ~5-10s.
#
# Build context is `frontend/` (see compose build.context). Dockerfile is
# placed in deploy/ so it can reuse the shared `Dockerfile.api` conventions.
#
# Docs:
#   https://vitejs.dev/guide/build.html
#   https://hub.docker.com/_/nginx

# Node 22 LTS (Node 20 EOL 2026-03-24 per nodejs.org/en/about/previous-releases);
# frontend/package.json engines allows >=22.12.0, Vite 8 needs 20.19+.
FROM node:22-bookworm-slim AS build
WORKDIR /web

ARG NPM_REGISTRY=http://hub

COPY package.json package-lock.json ./
RUN --mount=type=cache,id=bots-npm,target=/root/.npm,sharing=locked \
    npm ci --registry "${NPM_REGISTRY}" --prefer-offline --no-audit --no-fund

COPY . .
RUN npm run build

FROM nginx:1.30.5-alpine
COPY --from=build /web/dist /usr/share/nginx/html
# Cache-Control for index vs hashed assets — audit VITE-004–005 / backlog #20.
COPY nginx.default.conf /etc/nginx/conf.d/default.conf

ARG BUILD_HASH=unknown
LABEL org.opencontainers.image.title="alfa-ai-frontend"
LABEL org.opencontainers.image.revision="${BUILD_HASH}"
