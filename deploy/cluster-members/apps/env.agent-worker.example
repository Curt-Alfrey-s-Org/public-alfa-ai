# Remote agent worker env (copy to .env.agent-worker on target host)
# Brain on hub: Postgres :5540, Redis :6390, LiteLLM :8413

ALFA_AI_WORKER_HOST=105
ALFA_AI_APP_IMAGE=hub/alfa-ai-app:latest

DATABASE_URL=postgresql://user@hub/alfaai
REDIS_URL=redis://hub/0
LITELLM_BASE_URL=http://hub
LITELLM_API_KEY=REPLACE_LITELLM_MASTER_KEY

# Read-only repo mounts must match container paths below
ALFA_AI_AUDIT_ROOTS=contracts-bot=/workspace/contracts-bot,alfaqd-website=/workspace/alfaqd-website

ALFA_AI_AGENT_WORKER_POLL_SEC=15
ALFA_AI_AGENT_WORKER_BETWEEN_TASK_SEC=2
ALFA_AI_WORKER_HEARTBEAT_TTL_SEC=120
