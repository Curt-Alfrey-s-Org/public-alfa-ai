# Copy under each GPU entry in /etc/lact/config.yaml (4-space indent under GPU id).
# LACT CONFIG.md: https://github.com/ilya-zlobintsev/LACT/blob/master/docs/CONFIG.md
# NVIDIA: custom fan curves via NVML; auto_threshold returns to driver fan below set C.
fan_control_enabled: true
fan_control_settings:
  mode: curve
  static_speed: 1.0
  temperature_key: edge
  interval_ms: 500
  curve:
    40: 0.30
    50: 0.45
    60: 0.60
    70: 0.80
    80: 1.0
  spindown_delay_ms: 3000
  change_threshold: 2
  auto_threshold: 50
