.venv/
venv/
__pycache__/
*.pyc
.env
deploy/.env
deploy/petals/.env.worker
deploy/cluster-members/*/.env.worker
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
tmp/
*.tar.gz
# Local aria2 download staging (apps-105 aria2-env.sh)
data/aria2-downloads/
# aria2-pro bind-mount runtime: the p3terx/aria2-pro container runs as root and
# rewrites/chowns this whole tree in place, which breaks `git reset --hard` on hosts
# that sync as a non-root user (e.g. operator on hub) and aborts cluster stop/start.
# Config is host-local runtime; the tracked template is deploy/aria2/config.example/.
# See deploy/aria2/README.md.
deploy/aria2/config/
# cluster_lan_speedtest.sh transcripts (timestamped per run, purely local artifacts)
cluster-speedtest-*.log
# Worker run transcripts + bootstrap logs (machine-local; never commit)
deploy/cluster-members/*/logs/*
!deploy/cluster-members/*/logs/.gitkeep
# Dockge SQLite + config written on the worker host (generated by deploy)
dockge-data/
# Per-host Dockge bind paths (script-generated; paths differ per machine).
# Filename with no slash matches at any level (deploy/petals/, _common/dockge/, ...):
# https://git-scm.com/docs/gitignore
dockge.local.env
worker-monitor.local.env
# Accidental env backups from editors / scripts
deploy/**/.env*.bak*
deploy/petals/.env.worker.bak*
deploy/.env.apps
# Renamed legacy templates (gitignored if recreated locally). WSL templates
# deploy/cluster-members/_common/wslconfig-petals*.example stay tracked (not secrets).
*.example.bak
# Admin AI host-actions SSH key + known_hosts (docs/ADMIN_AI_HOST_ACTIONS.md). Must be
# ignored here (tracked file) so operator-cluster-111.sh `git clean -fd` keeps them on hub.
deploy/secrets/host-actions/*
!deploy/secrets/host-actions/.gitkeep
deploy/secrets/home-assistant/*
!deploy/secrets/home-assistant/.gitkeep
# Live operator env (gitignored). Secret-free routing template: deploy/env.example (tracked, no secrets).
deploy/.env.gateway
deploy/llamacpp-rpc/.env.rpc
deploy/llamacpp-rpc/.env.7b-serve
deploy/llamacpp-rpc/inference-shards.active.env
deploy/llamacpp-rpc/inference-gaming-selection.env
deploy/llamacpp-rpc/inference-desktop-gui.env
deploy/llamacpp-rpc/alfa-train.lock
deploy/llamacpp-rpc/alfa-7b-serve.lock
deploy/llamacpp-rpc/alfa-desktop-job.lock
deploy/llamacpp-rpc/models/
deploy/cluster-members/**/.env.dockge
# Windows Dockge local stack tree (see sync-dockge-stacks-windows.ps1)
stacks/
# hub seed transcripts fetched from hub → apps (operator-local)
logs/hub-seed/*.log
# Docker log dumps collected to apps for analysis (see LOG_CAPTURE_RUNBOOK.md)
logs/cluster-docker/
!logs/cluster-docker/.gitkeep
logs/inference-sessions/*
logs/brain-redeploy/*
!logs/brain-redeploy/.gitkeep
!logs/inference-sessions/.gitkeep
# Post-startup status logs (machine-local; see LOG_CAPTURE_RUNBOOK.md §5)
logs/cluster-status/
!logs/cluster-status/.gitkeep
# Author-host crash audit dumps (local diagnostics)
logs/crash-audit/
# 7B draft + 27B judge work loop JSONL (runtime; see ALFA_7B_27B_WORK_JUDGE.md)
logs/draft-judge/
# Path B confirmed sandbox drafts (runtime; ALFA_AI_WORKSPACE_ROOT)
draft-judge/applied/
logs/*.log
!logs/**/.gitkeep
# Cursor project hook audit (local observe; never commit)
.cursor/hooks/audit/*.jsonl
# Post-migration env archives (contain secrets)
deploy/.env.ARCHIVED*
# Synced bot wheels mirror (see scripts/sync-bot-wheels-from-hub.sh)
deploy/build-contexts/wheels-bots/*.whl
deploy/build-contexts/wheels-bots/.pip-cache/
deploy/build-contexts/wheels-bots/.tmp/
# Model staging downloads (binary GGUFs staged locally before hub sync)
models-staging/

# llama.cpp RPC runtime caches (tensor/graph cache + slot/prefix cache).
# Populated by rpc-server shards when using the cache overlay (-c) and by
# coordinators with --slot-save-path. Large binary blobs, host/GPU/model/quant
# specific, and automatically regenerated. Never commit these.
deploy/llamacpp-rpc/rpc-cache/
deploy/llamacpp-rpc/rpc-cache-*/
deploy/llamacpp-rpc/slot-cache*/

# One-off operator scratch / commit-helper scripts and staging trees.
# Common pattern on apps, orchestrator and elsewhere: tmp-105-*.sh, tmp-inference-*/,
# tmp-scp-in/, tmp-*.json, tmp-*.tgz, .tmp-prom-target.py, etc. These are
# disposable, often contain partial copies of docs or env fragments, and
# must not be committed.
tmp-*
tmp-*/
.tmp-*
.tmp-*/

# Agent implement-memory scratch (never commit)
.alfa_ai/
# Frontend/npm dependencies: install with `npm ci` (Dockerfiles already do). Never commit.
node_modules/
!deploy/secrets/README.md
!deploy/secrets/**/README.md
!*.example.env
!config/hosts.example.env
