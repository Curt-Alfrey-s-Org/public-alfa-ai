# Repo-root snippet -- canonical brain template is deploy/env.example.
# NEVER put secrets here. Copy deploy/env.example to deploy/.env and set secrets there only.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ALFA_AI_PROVIDER=litellm
DEFAULT_MODEL=frontier-code
ALFA_INFERENCE_MODE=inference

OLLAMA_BASE_URL=http://host.docker.internal:11434
LITELLM_BASE_URL=http://alfa-ai-litellm:4000
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_MODE=PRODUCTION
NO_DOCS=True
NO_REDOC=True
NO_OPENAPI=True
LITELLM_NUM_WORKERS=4

HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

ALFA_AI_WORKSPACE_ROOT=
ALFA_AI_COMMAND_TIMEOUT_SEC=30
ALFA_AI_MAX_COMMAND_OUTPUT_CHARS=12000

DATABASE_URL=
REDIS_URL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# Production: true. Local-only interactive dev may set false.
ALFA_AI_REQUIRE_API_AUTH=true
ALFA_AI_API_TOKEN=
ALFA_AI_JWT_SECRET=
ALFA_WORKER_HEARTBEAT_TOKEN=
